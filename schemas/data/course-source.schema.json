{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://italiano-contrastivo/schemas/data/course-source.schema.json",
 "title": "CourseSource",
 "type": "object",
 "additionalProperties": false,
 "description": "Archivo de autoría de la ruta (schemas/data/course.json). El pipeline le agrega las partes de cada unidad, las divergencias, la explicación y el estado para publicar web/public/content/course.json (ver course.schema.json).",
 "required": [
  "version",
  "levels",
  "units",
  "planned"
 ],
 "properties": {
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "source": {
   "type": "string"
  },
  "levels": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/Level"
   }
  },
  "modules": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/Module"
   }
  },
  "units": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/Unit"
   }
  },
  "planned": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/Planned"
   }
  }
 },
 "$defs": {
  "LevelId": {
   "type": "string",
   "pattern": "^(A|B|C)[12]\\+?$"
  },
  "Level": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "title",
    "guided_hours"
   ],
   "properties": {
    "id": {
     "$ref": "#/$defs/LevelId"
    },
    "title": {
     "type": "string",
     "minLength": 1
    },
    "guided_hours": {
     "type": "string"
    },
    "milestone": {
     "type": "boolean",
     "description": "El nivel tiene examen de hito que bloquea el paso al siguiente."
    }
   }
  },
  "Module": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "level",
    "title",
    "can_do_es",
    "units",
    "entry_reading",
    "roleplays",
    "tasks",
    "phrase_groups",
    "library",
    "library_task_es",
    "writing_es",
    "extra_readings"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^(?:[ab][12]m\\d+|m\\d+)$"
    },
    "level": {
     "$ref": "#/$defs/LevelId"
    },
    "title": {
     "type": "string",
     "minLength": 1
    },
    "can_do_es": {
     "type": "array",
     "minItems": 3,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "units": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "pattern": "^u\\d+$"
     }
    },
    "entry_reading": {
     "type": "string",
     "minLength": 1
    },
    "roleplays": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "tasks": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "phrase_groups": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "extra_readings": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "library": {
     "type": "string",
     "minLength": 1
    },
    "library_task_es": {
     "type": "string",
     "minLength": 1
    },
    "writing_es": {
     "type": "string",
     "minLength": 1
    },
    "writing_short_es": {
     "type": "string"
    },
    "gap_es": {
     "type": "string"
    }
   }
  },
  "Word": {
   "type": "object",
   "additionalProperties": true,
   "required": [
    "form",
    "gender",
    "num",
    "gloss"
   ],
   "properties": {
    "form": {
     "type": "string"
    },
    "gender": {
     "type": "string"
    },
    "num": {
     "type": "string"
    },
    "gloss": {
     "type": "string"
    },
    "art": {
     "type": "string"
    },
    "rule": {
     "type": "string"
    },
    "note": {
     "type": "string"
    },
    "gdiv": {
     "type": "boolean"
    },
    "ff": {
     "type": "boolean"
    }
   }
  },
  "Unit": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "level",
    "title",
    "goal_es",
    "codes",
    "why_here",
    "ficha_es"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^u\\d+$"
    },
    "level": {
     "$ref": "#/$defs/LevelId"
    },
    "title": {
     "type": "string",
     "minLength": 1
    },
    "goal_es": {
     "type": "string"
    },
    "codes": {
     "type": "array",
     "minItems": 1,
     "maxItems": 1,
     "items": {
      "type": "string",
      "pattern": "^ERR_[A-Z0-9_]+$"
     }
    },
    "why_here": {
     "type": "string"
    },
    "ficha_es": {
     "type": "string"
    },
    "readings": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "reading_is_entry": {
     "type": "boolean"
    },
    "words": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Word"
     }
    },
    "productive": {
     "type": "boolean",
     "description": "false = solo se reconoce (cápsulas [A] de A2): su prueba, el Cierre y el hito piden elegir, no escribir."
    }
   }
  },
  "Planned": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "level",
    "title",
    "reason"
   ],
   "properties": {
    "level": {
     "$ref": "#/$defs/LevelId"
    },
    "title": {
     "type": "string"
    },
    "reason": {
     "type": "string"
    }
   }
  }
 }
}

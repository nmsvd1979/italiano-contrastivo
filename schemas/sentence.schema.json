{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italiano-contrastivo/schemas/sentence.schema.json",
  "title": "Sentence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "it",
    "es",
    "cefr_estimate",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "tatoeba",
        "opus",
        "authored"
      ]
    },
    "source_id": {
      "type": "string",
      "description": "Id de la oración IT en Tatoeba/OPUS."
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "it": {
      "type": "string",
      "minLength": 1
    },
    "es": {
      "type": "string",
      "minLength": 1
    },
    "cefr_estimate": {
      "$ref": "common.schema.json#/$defs/Cefr"
    },
    "error_codes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ErrorCodeRef"
      }
    },
    "lexeme_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audio": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$",
      "description": "Hash sha1[0..12] del clip Piper."
    },
    "review_status": {
      "$ref": "common.schema.json#/$defs/ReviewStatus"
    },
    "es_source_id": {
      "type": "string",
      "description": "Id de la traducción ES directa en Tatoeba/OPUS."
    },
    "translation_kind": {
      "enum": [
        "direct",
        "pivot"
      ],
      "description": "direct = enlace Tatoeba ita-spa; pivot = ita→eng→spa."
    },
    "pivot_via": {
      "type": "string",
      "description": "Id Tatoeba de la oración inglesa puente."
    },
    "cefr_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "qa_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tag_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "código de error → id de la regla que lo etiquetó"
    },
    "es_author": {
      "type": "string",
      "description": "Autor de la oración española (CC BY exige atribuir también la traducción)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "enum": [
              "tatoeba",
              "opus"
            ]
          }
        }
      },
      "then": {
        "required": [
          "source_id",
          "license"
        ]
      }
    }
  ]
}
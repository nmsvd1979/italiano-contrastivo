    "typecheck": "tsc -p web/tsconfig.json"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "ts-fsrs": "6.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }

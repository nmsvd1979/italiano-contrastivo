[
  {
    "id": "00fec3a929da",
    "sha1": "00fec3a929da37553bd8039a79ef6dee197e5cd1",
    "text": "officine",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "0196ef6203d8",
    "sha1": "0196ef6203d8f7ae050a527baa8b7d8451772e2a",
    "text": "Tom conosce Mary molto bene.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "01a2bc331776",
    "sha1": "01a2bc3317762add6effddba157c90602e83e446",
    "text": "Io amo Mary così tanto.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "01aacf1f0c47",
    "sha1": "01aacf1f0c479cb2fe3a5ce77105497bffffe644",
    "text": "Non vedo Rick da quando è tornato dalla Nuova Zelanda.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "022d9d30052b",
    "sha1": "022d9d30052bba68703bdfefe2554ae14974d961",
    "text": "Lui arrivò prima del solito.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "0385bf8fbd60",
    "sha1": "0385bf8fbd608cf9d14db255c9476157ac4271c0",
    "text": "guardare",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "04693d7a86bf",
    "sha1": "04693d7a86bf9e3f70a9a3b37a3e11c9775e6ff9",
    "text": "Posso farlo senza il tuo aiuto.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "070dc15d7a84",
    "sha1": "070dc15d7a84b516bc0976061e48b547ce228eab",
    "text": "Sei andata in chiesa domenica scorsa?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "09fcfe797236",
    "sha1": "09fcfe797236b93b62d64bf83e1406ae2617d133",
    "text": "Io non vedo Tom da mesi.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "0aa9dded062e",
    "sha1": "0aa9dded062e6f1b81eb5a917636ce38bfb64dd0",
    "text": "asilo",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "0ac2f59e86b4",
    "sha1": "0ac2f59e86b4bb61901a1a6a9935dff0a190273a",
    "text": "Sono più basso di te.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "0edd869694c2",
    "sha1": "0edd869694c23910ab62d6d30c18551607775817",
    "text": "È più famosa di lui.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "13957aea6fa4",
    "sha1": "13957aea6fa4c08f74e16e5e4f59306f769d1c6b",
    "text": "Tokyo è più grande di Yokohama.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "1497e5dbe9ad",
    "sha1": "1497e5dbe9ad7a9579e7fa0ab6f8271e9f497d30",
    "text": "C'è una biro fra la mela e il libro.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "14dcc17a33cc",
    "sha1": "14dcc17a33cc336badecc12c52246cd7093f4e45",
    "text": "C'è un ostello della gioventù qui vicino?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "1558a27c9aa8",
    "sha1": "1558a27c9aa8e36a4abd1b835ed222e24d61a733",
    "text": "È andato a casa tre ore dopo.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "168246ca6822",
    "sha1": "168246ca682271bbc37c564c0a445ac36f1c887b",
    "text": "Mi è piaciuta la tua idea e l'ho adottata.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "16a1f51a71a7",
    "sha1": "16a1f51a71a7022ce659955a57b9f0ad0f8bbf0b",
    "text": "caldi",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "16cf90cf4002",
    "sha1": "16cf90cf40020e7dec620d1b2e917603710cec29",
    "text": "Non va a costruire cimiteri in Germania?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "17d3c52c11d7",
    "sha1": "17d3c52c11d7747376a1af433fc6735917d3f1cd",
    "text": "gambe",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "1890eda29acc",
    "sha1": "1890eda29acc9d7ee9e1564ac23ea8868ff098b3",
    "text": "Quanto si dà di mancia in Spagna?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "18ad0c995ff0",
    "sha1": "18ad0c995ff0d545e1ed9b5064e03f4da3365d6a",
    "text": "Ho bisogno del primo soccorso.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "18bb8ca9081d",
    "sha1": "18bb8ca9081d71f8a4f32424fc6efc750ecb50bf",
    "text": "Zwina non ha ragione.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "19579d1797b7",
    "sha1": "19579d1797b75afd0df95180dd6c950ebe9a1dfd",
    "text": "Ho cercato di conoscere la mia anima.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "1a45751f6c93",
    "sha1": "1a45751f6c93647c7c3a34fc37eded992305ac68",
    "text": "C'è un gatto davanti al cancello.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "1bb0c01edf1f",
    "sha1": "1bb0c01edf1f2428e1324442b90a75d6b56e6035",
    "text": "Tom non ha paura di te.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "1f7e32f84a68",
    "sha1": "1f7e32f84a689264f998e23f604df4e46791bcaf",
    "text": "Non andare nella mia stanza.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "234c30af21fb",
    "sha1": "234c30af21fbf2b6cbd3318a7896b6f10fc10874",
    "text": "Ci sono molte galassie nell'universo.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "237f34f32c2a",
    "sha1": "237f34f32c2a54f4e34bc3e1554e37fe585a9420",
    "text": "Ho perso la mia corona.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "2532b2cb8346",
    "sha1": "2532b2cb8346fac0eea836c42f25f1d58edc5069",
    "text": "Perché non hai paura?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "2726bab396d8",
    "sha1": "2726bab396d8ad823ac9be522c935006d1578cf2",
    "text": "pronto",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "2817b29ec11c",
    "sha1": "2817b29ec11c935275fe97aeb823039c1dbcad11",
    "text": "Hanno paura di Tom.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "29501a62c4bf",
    "sha1": "29501a62c4bfc599229112d2a76ac4fa2842767b",
    "text": "So che avete ragione.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "29a5e542fcd1",
    "sha1": "29a5e542fcd1fdf5fe6c5f77227d3098de60a661",
    "text": "caldo",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "29ab81fe4cd8",
    "sha1": "29ab81fe4cd8123534caf15985328ef003837337",
    "text": "Non vogliono andare in Germania.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "29b23818bb40",
    "sha1": "29b23818bb40075f0f1ecaf5f28da30180a092c0",
    "text": "Domani finalmente mia moglie viene in Italia!",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "2a21df6d03ba",
    "sha1": "2a21df6d03bab23e3860d0520959241dbd38428d",
    "text": "Riesci a distinguere l'argento dallo stagno?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "2cb4205342f8",
    "sha1": "2cb4205342f8256a516f3628dd0d9d1b8362e50e",
    "text": "Tutte le strade portano a Roma.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "2fd9311b71d9",
    "sha1": "2fd9311b71d9ab43a0659dd998fe6585020f5d8c",
    "text": "Tom ama Mary, però lei non ama lui.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "30af74d1e0fc",
    "sha1": "30af74d1e0fce820f0331e4c42b11e7d1742e2fa",
    "text": "Di solito vado al parco.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "30e3fb6fe1bc",
    "sha1": "30e3fb6fe1bc1abec91448613a88d5a3ffd019f9",
    "text": "Il suo inglese è migliorato molto.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "31c3bddcbb93",
    "sha1": "31c3bddcbb93f47b78c597fb973c1560e149c04d",
    "text": "Io conosco Jim da quando ero bambina.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "31e46bd06987",
    "sha1": "31e46bd06987b7f3192700f2d032f658ffa5e3dc",
    "text": "Tom conosce Mary da molto tempo.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "325ddbecf5db",
    "sha1": "325ddbecf5dbfc14ae1a8bf85601b70cfe40c9d3",
    "text": "Nelle Antille ci sono delle spiagge magnifiche.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "330dadbb4d6a",
    "sha1": "330dadbb4d6ae5245ba6b0193a4e4b26c98ec2f5",
    "text": "Lei ha paura dei tuoni.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "337a9fe17421",
    "sha1": "337a9fe17421dbfd73ff614c941fbeeb6a41ceaf",
    "text": "Ci sono molti fiori nel giardino?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "361ed1293637",
    "sha1": "361ed1293637392aba19fe94b518d7face0a95be",
    "text": "L'ho sentito alla radio.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "369b212117f7",
    "sha1": "369b212117f7bb0dab43432e17dcd683ba256621",
    "text": "Siamo andati al centro commerciale ieri.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "36f16d96541f",
    "sha1": "36f16d96541f997080a3bdc6dbaa7d66adc5a48c",
    "text": "Io non amo Tom.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "396866188412",
    "sha1": "39686618841296710ca4380d0f674d7779362c32",
    "text": "Sei sicura che conosci Tom?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "39918e8aaa3a",
    "sha1": "39918e8aaa3afbe379cdc5a321515006af1a15e9",
    "text": "Lui è più intelligente di loro.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "3c296afaa06c",
    "sha1": "3c296afaa06c04130ddd752de58a1e5376af2311",
    "text": "Tom sa che Mary ama John.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "3dd0c0596298",
    "sha1": "3dd0c05962980afa288b6800050d12a3fdd4fdce",
    "text": "Suo fratello è più paziente di lui.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "3ebd5c0f8d13",
    "sha1": "3ebd5c0f8d131c228c766df2f50cdbf4a56d2634",
    "text": "Io sono abituato al dolore adesso.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "3fa3f565e0d3",
    "sha1": "3fa3f565e0d32bc74a13a52aac4318b6fe127130",
    "text": "Lui ha paura di dire ai suoi genitori che è omosessuale.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "42ab9caa8a85",
    "sha1": "42ab9caa8a85e7f0a8bf1fac54974b6df963ab6f",
    "text": "L'uomo ha ragione.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "44015e99248e",
    "sha1": "44015e99248e58c06db602eba24993a8f4476b04",
    "text": "Se ne è andata.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "491604778ef1",
    "sha1": "491604778ef1fe542de18cd73633f20cabded639",
    "text": "Sono già stato a Londra.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "4cf096243e32",
    "sha1": "4cf096243e32b76642193c89047152b49a393a19",
    "text": "Fino a quando continueremo a credere che siamo nati per sterminarci a vicenda e che lo sterminio reciproco sia il nostro destino?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "4d142da4be68",
    "sha1": "4d142da4be68c2db0a899654a9e4af0b1c74bb03",
    "text": "Vado a Parigi domani.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "4d72d0d5e24e",
    "sha1": "4d72d0d5e24e920c90429788e804cc80891a45bb",
    "text": "Tom non conosce i suoi vicini.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "4d9ca6d38278",
    "sha1": "4d9ca6d382782e8032e7a3694b2db61a7495b738",
    "text": "Io abito a Parigi.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "4f1948ad967e",
    "sha1": "4f1948ad967e843c38378c8cdb0b80ff307297a0",
    "text": "Da quanto tempo conosci Judy?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "55a885aeccd3",
    "sha1": "55a885aeccd3e751234b3880c9b4b0d17647ce5d",
    "text": "Ho fame perché non ho fatto colazione.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "58471d75a0df",
    "sha1": "58471d75a0dfdaa31bfd374e8af0f5002a2014f0",
    "text": "Ora lavora in Francia.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "5a14bd529a52",
    "sha1": "5a14bd529a520028a1ceccf369f40a5b5d8fec30",
    "text": "Il gazebo, o pergolato, è uno spazio, di solito rotondo, che solitamente si trova nei giardini, circondato da piante o alberi e panchine.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "5b275184497a",
    "sha1": "5b275184497ae5e60f12717ef87bc7004bb5463a",
    "text": "salgo",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "5b417aa380c8",
    "sha1": "5b417aa380c88d2e14cffe5de777c5804aa53f33",
    "text": "Tom pensa che io ami Mary.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "5d5207cabcb1",
    "sha1": "5d5207cabcb1d8c903c92c282795c1ce0064a5a8",
    "text": "Qual è il nome del vostro migliore amico?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "5d9c652337a9",
    "sha1": "5d9c652337a942068d5fffaacb837d6285e937c3",
    "text": "aceto",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "5e11eb4ff1cf",
    "sha1": "5e11eb4ff1cfa86ebdb4814b0367c0cb7fd1e1ce",
    "text": "largo",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "5eebf4bae41a",
    "sha1": "5eebf4bae41ad883f52df4f1176cb933708a001d",
    "text": "pretendere",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "5f6e7c0ae7e8",
    "sha1": "5f6e7c0ae7e82c1f76af938bde99dd00cf0d2040",
    "text": "La popolazione dell'Uganda è in rapida crescita.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "5f7c89084bca",
    "sha1": "5f7c89084bca158bd60b33858de669097f49fe24",
    "text": "Sono molto più alti di noi.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "5fedce285429",
    "sha1": "5fedce285429f9d9090b9fad0b45af9fb1100809",
    "text": "Vuole che chiami Tom?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "6189cf55c70b",
    "sha1": "6189cf55c70b286675e8031e4c9b5a712ed22a9d",
    "text": "Per favore, chiama Tom.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "63d306fba933",
    "sha1": "63d306fba9332eed3ae5dc1354661a9d27419256",
    "text": "Si può dire che è morto felice.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "64889a03fbf5",
    "sha1": "64889a03fbf552afefb993eaaa769458c7c952aa",
    "text": "spalla",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "652a3cb07524",
    "sha1": "652a3cb0752424884e5fd6722ab9cd7b955edbd6",
    "text": "Lei ha paura che tu ti perda.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "65d99c405ed8",
    "sha1": "65d99c405ed8d320daaf0c0380599a85e94c5a37",
    "text": "C'è un piccolo giardino davanti alla mia casa.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "65ecc9b68f2f",
    "sha1": "65ecc9b68f2fe3c8cad074098926dfbb5dbcd93d",
    "text": "allora",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "66736f65135a",
    "sha1": "66736f65135a326795b1e59429db9b5cef22bb02",
    "text": "Qual è il nome della sua migliore amica?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "66fd2228eddc",
    "sha1": "66fd2228eddc47b66bc21ee148721cba4ef043d2",
    "text": "imbarazzato",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "688fb7fba7f6",
    "sha1": "688fb7fba7f60c47ad5fd5c7fa56a96554825bbc",
    "text": "Mio zio vive a Londra.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "696ed9d957f7",
    "sha1": "696ed9d957f73bdfb8cf081b40c5a43ab6180ed1",
    "text": "La Pasqua è alle porte.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "6a0e9117cc9e",
    "sha1": "6a0e9117cc9e38d3b77100dbf90059ec5f0cbcec",
    "text": "Nancy ha paura dei cani.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "6ab27394c411",
    "sha1": "6ab27394c411c28acea0e5d74839372b5403d241",
    "text": "Pechino è più grande di Roma.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "6b54aea97ee1",
    "sha1": "6b54aea97ee1ea1a13bb312797c2f7d12c739700",
    "text": "Tom è più alto di me.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "6b6f4d0d6e22",
    "sha1": "6b6f4d0d6e2275c69abda768e2e07f7c9146b33c",
    "text": "Vedrete che ho ragione.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "6b878212ab23",
    "sha1": "6b878212ab230c767154b3c504e556d3aa442e67",
    "text": "Nel mezzo della discussione si è alzato ed è uscito.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "6bea5d543046",
    "sha1": "6bea5d5430468f4083787a724d54eb13070afb64",
    "text": "Mangiate, perché avete fame.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "6c2676f3537d",
    "sha1": "6c2676f3537dc26640b2e2d49a8b1f3754f0395e",
    "text": "È nato a Osaka.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "6e6b64c4c403",
    "sha1": "6e6b64c4c403b78ba97f7271549c9223130b02a1",
    "text": "Taro è morto due anni fa.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "70400db15b62",
    "sha1": "70400db15b62051d3b3c74d98c33fa28aca6747a",
    "text": "L'Africa del Nord adotta il monofisismo in segno di protesta.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "70c2c767e561",
    "sha1": "70c2c767e56185700f4d12f5c5950c270513b500",
    "text": "Io vedo Dana e Corina.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "70fa39bc1444",
    "sha1": "70fa39bc1444a6ac0d4e9c3715d58231c2e8823a",
    "text": "Barcellona è in Spagna.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "7390173f3816",
    "sha1": "7390173f3816e8614aac84c95b127cebf273fe92",
    "text": "Una corda è stata gettata nell'acqua.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "740c8547b9b5",
    "sha1": "740c8547b9b5afbab241f9296038cd1a9968be5f",
    "text": "La pigrizia è il divano del diavolo.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "77ff67106e9f",
    "sha1": "77ff67106e9fa3032a5743d5a6686caa44ef3d48",
    "text": "Lui è l'autore dell'articolo.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "789321ed499b",
    "sha1": "789321ed499bf0a52e47373b81f4f2411f7fa421",
    "text": "Tu non hai caldo?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "7972f76c5379",
    "sha1": "7972f76c537952d6e3e5967790170b1691623694",
    "text": "Lei abita a Londra.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "7b98e32539c9",
    "sha1": "7b98e32539c99411140f4ddd906147c17c9c4cee",
    "text": "Ci sono molte lingue nel mondo.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "7c0b65540b99",
    "sha1": "7c0b65540b99c25199ac956e50f90476a6c92505",
    "text": "officina",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "7c3cc6ccc901",
    "sha1": "7c3cc6ccc901d152b7633ed7039f86d0cdb8e5aa",
    "text": "Ho visto delfini più intelligenti di te.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "7d9175cd5396",
    "sha1": "7d9175cd53964eee465e30282846314593ca03a2",
    "text": "La forza ha ragione.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "7ded28822b39",
    "sha1": "7ded28822b39943352c5123dc11ad69a53ddd819",
    "text": "Sei sicuro che conosci Tom?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "80322cb43634",
    "sha1": "80322cb43634e43233fb48f366c2a84efa3df831",
    "text": "Lui abbreviava i suoi discorsi.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "804b9a8f4bd9",
    "sha1": "804b9a8f4bd900da6e49feb2f914c2f33399a8a6",
    "text": "Tu hai distrutto i tuoi nemici.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "80beaa2667d9",
    "sha1": "80beaa2667d91090cf008f1ddd00e025f5aaf4c9",
    "text": "Lei non ha caldo?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "812b05a503c4",
    "sha1": "812b05a503c4a2b538e94cf715cdedaf1cfbac38",
    "text": "Oh, i miei pantaloni bianchi! Erano nuovi.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "821c7d5915e5",
    "sha1": "821c7d5915e50b0a3e6fb7ba10df2983a50c1772",
    "text": "È ovvio che ha ragione.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "829a9c1acf84",
    "sha1": "829a9c1acf849bcb7763ca1371bdb7a1fd044ee0",
    "text": "Nonostante Tom sia ammalato, ha intenzione di finire in tempo i suoi compiti.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "87211957afa1",
    "sha1": "87211957afa1f3f405c1f5b0cbf46549233851cf",
    "text": "larghi",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "884000109440",
    "sha1": "884000109440b31fb53c8b1ee425c413defee43a",
    "text": "Il topo ha mangiato il mio formaggio.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "88beb3ea1536",
    "sha1": "88beb3ea1536b5b7dc161513b52630c582b94d52",
    "text": "Sei uscito ieri sera?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "88c923b25d7a",
    "sha1": "88c923b25d7aeef0e08d4eaa9f95ab78ea2a4f16",
    "text": "Lui ha messo tutti i suoi soldi nella scatola.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "8bcdf7a99185",
    "sha1": "8bcdf7a9918551dec411e8c85e128a4aa340f51b",
    "text": "Io ho paura delle tenebre.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "8c4d9d9c09ab",
    "sha1": "8c4d9d9c09ab067f5ffeb8326d68297decd8879e",
    "text": "So che hai ragione.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "8c5f619519c0",
    "sha1": "8c5f619519c0f3dff10afe7f7215e3bbe266ee75",
    "text": "Ha paura di perdere influenza e attenzione.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "8dac826f83d8",
    "sha1": "8dac826f83d80a22ae29214c9d913efcdb398ebe",
    "text": "Finché c'è un obiettivo, c'è speranza.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "8de671424188",
    "sha1": "8de6714241885e57beb3271840195c09a0012763",
    "text": "Ci sono molte fabbriche a Kawasaki.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "8e81c702631d",
    "sha1": "8e81c702631d27f26b39146de8df056d0ba693b4",
    "text": "Siamo stati a Parigi.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "914e54ac019c",
    "sha1": "914e54ac019c137cc78ef504257a2dc9a605c2da",
    "text": "Sono più bassa di te.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "91c9d5d2e326",
    "sha1": "91c9d5d2e326ff3b1f5384c45bc716609ec8a8b5",
    "text": "Lui è più bravo di me a insegnare.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "9248feb06a21",
    "sha1": "9248feb06a21245370d9f5b9cf73a998f45621a8",
    "text": "Questa è la mia amica Rachel. Siamo andati alle superiori assieme.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "92af3f4e6eca",
    "sha1": "92af3f4e6eca79667b7e35f80e2a7c8b5387a8f7",
    "text": "C'è un McDonald's qua vicino?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "9309e885ea1e",
    "sha1": "9309e885ea1e76b52279aac0e66633853d49a0d4",
    "text": "È venuto a Berlino come insegnante.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "9463e927d5dc",
    "sha1": "9463e927d5dcb45359020fe3c44d658409897ddc",
    "text": "pronti",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "94b7732bf9fe",
    "sha1": "94b7732bf9feb0c1fb9bb9abcf5fb5ba78fb395e",
    "text": "salgono",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "95eb576e0c23",
    "sha1": "95eb576e0c23fa601bc800f7d5fa148bf2064233",
    "text": "gamba",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "95fc86fdbac3",
    "sha1": "95fc86fdbac3629ece7eba3be37b3647d65e4ff3",
    "text": "Dalla cima di quell'albero c'è una vista fantastica.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "976347eccd6b",
    "sha1": "976347eccd6bdb59df9ea3346f2f529aa12fbece",
    "text": "C'è un gatto sulla sedia.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "98eb55c5d295",
    "sha1": "98eb55c5d295c263a0c4b0306d8a3ff9d1e1ccd5",
    "text": "La nostra squadra portava delle magliette rosse.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "99b294a6b1ad",
    "sha1": "99b294a6b1ad517bef8d20b3efdb426536b3d5ba",
    "text": "salire",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "99cc7b6daf3f",
    "sha1": "99cc7b6daf3f536011543f2662f857923526d586",
    "text": "Tu conosci Tom di persona?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "9b078b05f2fd",
    "sha1": "9b078b05f2fd942e8edd1b37071b1cda777a6c78",
    "text": "larga",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "9c09983102ad",
    "sha1": "9c09983102ad158e7049dcb99426689e69fb342c",
    "text": "La musica nutre la nostra immaginazione.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "9d903fb0f665",
    "sha1": "9d903fb0f665b2516e5789b46bfd1201ec903fca",
    "text": "È venuto nonostante gli avessi detto di non farlo.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "9f14087b56b3",
    "sha1": "9f14087b56b3d9f7c0e46b21917535dee1738633",
    "text": "Mi piacerebbe andare in Francia.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "9feabb49803e",
    "sha1": "9feabb49803e5cf030ac6cda1fc1a9f3b9aa1906",
    "text": "Ora che sei in Italia, devi vedere Napoli.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "a33935f0350c",
    "sha1": "a33935f0350cbac76d4b454be718f8a2f06f69f1",
    "text": "Kaoru è andato in America.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "a3f2fe4070a8",
    "sha1": "a3f2fe4070a80dbb0790f33bfa9e615536af64f0",
    "text": "pronta",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "a7083ec98511",
    "sha1": "a7083ec9851153a612421bd98b1c41752bae95a6",
    "text": "Ho paura di cadere.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "a8c1a8aee384",
    "sha1": "a8c1a8aee3847c780e20bbf3f97c26022592ba4c",
    "text": "Nel giardino ci sono molti fiori.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "a9ceb969a547",
    "sha1": "a9ceb969a547de2c155c991c123dba8febd54374",
    "text": "imbarazzata",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "aba733b1654a",
    "sha1": "aba733b1654afbd99cf6de9447d967ddf08b8dbd",
    "text": "A me piacerebbe studiare a Parigi.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "abc0047a2e18",
    "sha1": "abc0047a2e180ed0aeeabcd292b3f4f93d189166",
    "text": "Nel mondo ci sono quattro oceani.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "ac332af1df00",
    "sha1": "ac332af1df0051c889d0e3fce2ba45fa1784663d",
    "text": "Lui non è più forte di me.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "ad1928208acd",
    "sha1": "ad1928208acd6050c470530550f3427704574e5c",
    "text": "Vedrai che ho ragione.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "af7117a1f961",
    "sha1": "af7117a1f961de6bac2e23a23324980f4a0865e0",
    "text": "pretende",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "afd30d00f57a",
    "sha1": "afd30d00f57af37577c86cae8bec73a85e04dfb1",
    "text": "Sono un po' più alto di te.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "b032d1894237",
    "sha1": "b032d1894237ae60e3725a37681f45a45a18ba66",
    "text": "Tom è in macchina che aspetta Mary.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "b0ca8fb27901",
    "sha1": "b0ca8fb279018923e457c0a5dd32025db68942af",
    "text": "La mia sorella maggiore ha i capelli che le cadono sulle spalle.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "b0f8e771d839",
    "sha1": "b0f8e771d8392757f2e727a48fc082f7c9919de3",
    "text": "carta",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "b6271844e3b6",
    "sha1": "b6271844e3b6e65f97fa1ad797acc603ee3e44ab",
    "text": "Ci sono dei negozi lungo la strada.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "b649c6572a6c",
    "sha1": "b649c6572a6c05ae228db120414d39addee921e2",
    "text": "Sono più veloce di voi.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "b6a57dc25894",
    "sha1": "b6a57dc25894467bff35426dbb3b91008e236454",
    "text": "Il diavolo è morto.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "b6ffbb277c63",
    "sha1": "b6ffbb277c63af073603c125e04d98f0781f3db6",
    "text": "È due anni più giovane di me.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "b71748dd4329",
    "sha1": "b71748dd4329c289a7ac31c999d084f5e5bc7453",
    "text": "So che ha ragione.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "ba1c268f3f27",
    "sha1": "ba1c268f3f27fd0cabfad07385037d7fedd08950",
    "text": "Le sue calze sono grigie.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "ba6643cab80e",
    "sha1": "ba6643cab80e832c1d1d21ea28b15bb51f3862dc",
    "text": "Si adatta perfettamente a tutte le tue esigenze?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "bc5cca70e6c7",
    "sha1": "bc5cca70e6c7bd1c55bf793eccbeb4aa91511575",
    "text": "Lei ha mostrato i suoi talenti.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "bea555d60b51",
    "sha1": "bea555d60b519bfd36d36b2626fb55cbbb2faebf",
    "text": "ritardato",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "c48b70fba7d5",
    "sha1": "c48b70fba7d50fb01679422c83f0554902d714bd",
    "text": "Lei è molto più alta di me.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "c5852eaa0f63",
    "sha1": "c5852eaa0f631f7bfe34f4fd7863ffed87c0c25c",
    "text": "Forse hai ragione.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "c5b72105f017",
    "sha1": "c5b72105f017ff5a43d9725fd82c483522069703",
    "text": "Anche i tedeschi hanno un senso dell'umorismo.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "c68179b32d92",
    "sha1": "c68179b32d92eadf44764fa8bde51e9b6ddb903a",
    "text": "Tu sei drogato da quando sei nato.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "c6ba45f1b6cc",
    "sha1": "c6ba45f1b6cc5ef0d2d5f4a16c8d39d36ecc4fe9",
    "text": "burro",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "cabadce6b2ad",
    "sha1": "cabadce6b2adfe0ec39d93028b28cf6851666040",
    "text": "L'uomo che ha dato la sua busta paga alla moglie è stato più saggio di quello che l'ha data all'amante.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "ccf5c524d68e",
    "sha1": "ccf5c524d68edafeacd9e7222f332fc8abc03b9d",
    "text": "La mia famiglia va in Italia tutti gli anni.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "ccfe47c83cc6",
    "sha1": "ccfe47c83cc676bcb2ca57c9a64e8bd233d7cf1d",
    "text": "Tutto è caro a Londra.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "cebbe06f66f6",
    "sha1": "cebbe06f66f6f5f314e5174ccf9c94e2aa0e6aa3",
    "text": "spalle",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "d0a1a8e951bd",
    "sha1": "d0a1a8e951bd0be317281b00d00e6388c768ab93",
    "text": "La statua fu costruita in Francia.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "d0f287ebe91f",
    "sha1": "d0f287ebe91f2daef43c1ff43a7676245c6b336f",
    "text": "Mi piacerebbe studiare a Parigi.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "d1625e1940ee",
    "sha1": "d1625e1940ee3ca3baf046623d93a0ae496d982a",
    "text": "Io conosco Tom da quand'ero un ragazzino.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "d181a92971f7",
    "sha1": "d181a92971f72196e86b5b45e7013f165ae44aa2",
    "text": "Tom ha sviluppato la sua strategia per sedurre una donna.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "d30578273cf3",
    "sha1": "d30578273cf3d8969a92301de0be07d5715f188b",
    "text": "pretendo",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "d3e318251fa8",
    "sha1": "d3e318251fa87cdf899863ff6210724e1c0627da",
    "text": "Siete venuti in città?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "d46c686f884b",
    "sha1": "d46c686f884b46fdd59300ecf8bf66065860bfca",
    "text": "Per me è finita con le feste, il mio corpo malato non ce la fa più.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "d6cb9e7dce5e",
    "sha1": "d6cb9e7dce5e702ec854d7692ad5edac10d68ee4",
    "text": "Tom ha paura di noi, vero?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "d72e1a0e94be",
    "sha1": "d72e1a0e94be98443d7216937093d9b68b91ce3c",
    "text": "La donna ha ragione.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "d75da932f229",
    "sha1": "d75da932f22920dfe20bff43cec64835998a6e21",
    "text": "Forse pioverà nel pomeriggio.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "d8913cd75866",
    "sha1": "d8913cd758663ebf3a2ad4f6c977ce5af10e908e",
    "text": "larghe",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "dcbc4b8ea31d",
    "sha1": "dcbc4b8ea31d54184e368900e90cb3d754e01de5",
    "text": "Lei ha distrutto i suoi nemici.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "de5b76d6dbd1",
    "sha1": "de5b76d6dbd1f94ed31675b6ee38e3fb22661b88",
    "text": "Oh, là c'è una farfalla!",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "dea1dee7230d",
    "sha1": "dea1dee7230d4677e7dd49e6478ed3bb563b4787",
    "text": "Devo segnarmi il suo indirizzo prima che me lo scordi.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "dfd7dc926d05",
    "sha1": "dfd7dc926d05305b5e44dfd8df4f921e5023d5de",
    "text": "Ci sono alcune uova nella scatola.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "dfdac4b14628",
    "sha1": "dfdac4b14628d6713e3d7b1a6a8d69eb38195ce1",
    "text": "Il suo ragazzo è turco.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "e06d1a320f76",
    "sha1": "e06d1a320f76c290913cba70cb6c23b434ac4910",
    "text": "Ha paura di fare errori.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "e177274155ef",
    "sha1": "e177274155ef783c067ffc6ecdd231b52feebbc3",
    "text": "La polizia lo seguì a Parigi.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "e1ebd6d58b61",
    "sha1": "e1ebd6d58b61208757e3a2250988e09a367c5bb1",
    "text": "Tom parla più lentamente di Bill.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "e271621aff05",
    "sha1": "e271621aff05ef8b7b99c6b94b5e64c5ae9108b4",
    "text": "Sami conosce Layla dalle medie.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "e2c5ba788044",
    "sha1": "e2c5ba788044a81916dd513f2c06c0f37e52ad08",
    "text": "C'è un cagnolino marrone sotto quel tavolo.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "e44a85357e57",
    "sha1": "e44a85357e5794cc9ab4fe20473a7319d76932a6",
    "text": "Ha lavorato senza pausa per mantenere i suoi figli fino a che si sono sposati.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "e4804a9f9358",
    "sha1": "e4804a9f9358502921d64005d3fd8a716c569e56",
    "text": "Nonostante Tom sia malato, ha intenzione di finire in tempo i suoi compiti.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "e56c4b2a748e",
    "sha1": "e56c4b2a748ec9ae7c34b7fbb053a87dc8758635",
    "text": "Quell'uomo è morto.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "e674c628da55",
    "sha1": "e674c628da55654545b37541677e90036d397769",
    "text": "Mi sono alzato presto come al solito.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "e9efedf5626e",
    "sha1": "e9efedf5626e8056c793febdd95f361f1cc55641",
    "text": "Hanno paura di loro.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "ed01d047f247",
    "sha1": "ed01d047f2477ecf620aab8683bc2779d6236851",
    "text": "Parlando in generale, Tom ha ragione.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "ed07f06c89e3",
    "sha1": "ed07f06c89e3ca086f36296e45dac328763adeb7",
    "text": "La colpa è del governo.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "ee7cd507b3ba",
    "sha1": "ee7cd507b3ba2888d55d875f87a2fbfe33016806",
    "text": "È arrivato prima del solito.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "f0e62b27cebf",
    "sha1": "f0e62b27cebf9d6bad7c74038f2058a46ce54033",
    "text": "C'è un problema, Tom?",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "f25b99c31628",
    "sha1": "f25b99c31628663d910c28775d33bda793ceb546",
    "text": "Sei arrivato in tempo.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "f35a7311dc02",
    "sha1": "f35a7311dc02ca18a5d5f250617566d93f654c80",
    "text": "Io conosco Tom di persona.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "f4ce2711de10",
    "sha1": "f4ce2711de10630ef6e849c803999bcd69f4d6fc",
    "text": "Roma è in Italia.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "f7fe9087a8c3",
    "sha1": "f7fe9087a8c30bb0ec22b27602d25e0c42ade996",
    "text": "La tua bicicletta è migliore della mia.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "f8a850b042e4",
    "sha1": "f8a850b042e4b065e181ea6e1c615a31844f03b0",
    "text": "Vedrà che ho ragione.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "fa7b875b0c26",
    "sha1": "fa7b875b0c26aa92ebadca693a0fd91dca8b1d47",
    "text": "carte",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "fca2c1ce38c8",
    "sha1": "fca2c1ce38c84819f15c86df9df52b8392e9eb83",
    "text": "calda",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "fee23a2326f0",
    "sha1": "fee23a2326f0959f06a8aafac3e62926b376ff7d",
    "text": "Devi tenere in mente che lei è molto più giovane di te.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  },
  {
    "id": "feefbdf05074",
    "sha1": "feefbdf05074da23810a15a136517fd0b1d2d0c8",
    "text": "Domani vado a Parigi.",
    "voice": "it_IT-serena-high",
    "license": "CC BY 4.0"
  }
]

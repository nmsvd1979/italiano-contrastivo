[
  {
    "author": "riccioberto",
    "cefr_estimate": "A1",
    "es": "En el mundo hay cuatro océanos.",
    "es_author": "tatoerique",
    "es_source_id": "346354",
    "id": "s_1015680",
    "it": "Nel mondo ci sono quattro oceani.",
    "license": "CC BY 2.0 FR",
    "source_id": "1015680",
    "translation_kind": "direct"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "A1",
    "es": "Mañana voy a París.",
    "es_author": "IA (Claude)",
    "id": "s_1082492",
    "it": "Domani vado a Parigi.",
    "license": "CC BY 2.0 FR",
    "source_id": "1082492",
    "translation_kind": "llm"
  },
  {
    "author": "riccioberto",
    "cefr_estimate": "A1",
    "es": "¿Hay muchas flores en el jardín?",
    "es_author": "hayastan",
    "es_source_id": "1086356",
    "id": "s_1086143",
    "it": "Ci sono molti fiori nel giardino?",
    "license": "CC BY 2.0 FR",
    "source_id": "1086143",
    "translation_kind": "direct"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "A1",
    "es": "Zwina no tiene razón.",
    "es_author": "IA (Claude)",
    "id": "s_12434343",
    "it": "Zwina non ha ragione.",
    "license": "CC BY 2.0 FR",
    "source_id": "12434343",
    "translation_kind": "llm"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "A1",
    "es": "Yo vivo en París.",
    "es_author": "IA (Claude)",
    "id": "s_13267842",
    "it": "Io abito a Parigi.",
    "license": "CC BY 2.0 FR",
    "source_id": "13267842",
    "translation_kind": "llm"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "A1",
    "es": "Voy a París mañana.",
    "es_author": "IA (Claude)",
    "id": "s_13267986",
    "it": "Vado a Parigi domani.",
    "license": "CC BY 2.0 FR",
    "source_id": "13267986",
    "translation_kind": "llm"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "A1",
    "es": "La mujer tiene razón.",
    "es_author": "IA (Claude)",
    "id": "s_13300838",
    "it": "La donna ha ragione.",
    "license": "CC BY 2.0 FR",
    "source_id": "13300838",
    "translation_kind": "llm"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "A1",
    "es": "La fuerza tiene razón.",
    "es_author": "IA (Claude)",
    "id": "s_13437351",
    "it": "La forza ha ragione.",
    "license": "CC BY 2.0 FR",
    "source_id": "13437351",
    "translation_kind": "llm"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "A1",
    "es": "Sé que tienes razón.",
    "es_author": "IA (Claude)",
    "id": "s_2023101",
    "it": "So che hai ragione.",
    "license": "CC BY 2.0 FR",
    "source_id": "2023101",
    "translation_kind": "llm"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "A1",
    "es": "Sé que tiene razón.",
    "es_author": "IA (Claude)",
    "id": "s_2023103",
    "it": "So che ha ragione.",
    "license": "CC BY 2.0 FR",
    "source_id": "2023103",
    "translation_kind": "llm"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "A1",
    "es": "Sé que tienen razón.",
    "es_author": "IA (Claude)",
    "id": "s_2023105",
    "it": "So che avete ragione.",
    "license": "CC BY 2.0 FR",
    "source_id": "2023105",
    "translation_kind": "llm"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "A1",
    "es": "El hombre tiene razón.",
    "es_author": "IA (Claude)",
    "id": "s_2762874",
    "it": "L'uomo ha ragione.",
    "license": "CC BY 2.0 FR",
    "source_id": "2762874",
    "translation_kind": "llm"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "A1",
    "es": "Tom no conoce a sus vecinos.",
    "es_author": "termito2nd",
    "es_source_id": "1585306",
    "id": "s_2845274",
    "it": "Tom non conosce i suoi vicini.",
    "license": "CC BY 2.0 FR",
    "source_id": "2845274",
    "translation_kind": "direct"
  },
  {
    "author": "Pharamp",
    "cefr_estimate": "A1",
    "es": "Mi tío vive en Londres.",
    "es_author": "Shishir",
    "es_source_id": "1797010",
    "id": "s_376530",
    "it": "Mio zio vive a Londra.",
    "license": "CC BY 2.0 FR",
    "source_id": "376530",
    "translation_kind": "direct"
  },
  {
    "author": "Pharamp",
    "cefr_estimate": "A1",
    "es": "En el jardín hay muchas flores.",
    "es_author": "tatoerique",
    "es_source_id": "339050",
    "id": "s_384874",
    "it": "Nel giardino ci sono molti fiori.",
    "license": "CC BY 2.0 FR",
    "source_id": "384874",
    "translation_kind": "direct"
  },
  {
    "author": "Pharamp",
    "cefr_estimate": "A1",
    "es": "Puede que tengas razón.",
    "es_author": "Shishir",
    "es_source_id": "543932",
    "id": "s_390103",
    "it": "Forse hai ragione.",
    "license": "CC BY 2.0 FR",
    "source_id": "390103",
    "translation_kind": "direct"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "A2",
    "es": "En medio de la discusión se levantó y se fue.",
    "es_author": "nancy",
    "es_source_id": "1170593",
    "id": "s_1082726",
    "it": "Nel mezzo della discussione si è alzato ed è uscito.",
    "license": "CC BY 2.0 FR",
    "source_id": "1082726",
    "translation_kind": "direct"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "A2",
    "es": "Verás que tengo razón.",
    "es_author": "IA (Claude)",
    "id": "s_13382886",
    "it": "Vedrai che ho ragione.",
    "license": "CC BY 2.0 FR",
    "source_id": "13382886",
    "translation_kind": "llm"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "A2",
    "es": "Verá que tengo razón.",
    "es_author": "IA (Claude)",
    "id": "s_13382887",
    "it": "Vedrà che ho ragione.",
    "license": "CC BY 2.0 FR",
    "source_id": "13382887",
    "translation_kind": "llm"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "A2",
    "es": "Verán que tengo razón.",
    "es_author": "IA (Claude)",
    "id": "s_13382888",
    "it": "Vedrete che ho ragione.",
    "license": "CC BY 2.0 FR",
    "source_id": "13382888",
    "translation_kind": "llm"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "A2",
    "es": "A mi hermana mayor el cabello le llega hasta los hombros.",
    "es_author": "tatoerique",
    "es_source_id": "338836",
    "id": "s_1802972",
    "it": "La mia sorella maggiore ha i capelli che le cadono sulle spalle.",
    "license": "CC BY 2.0 FR",
    "source_id": "1802972",
    "translation_kind": "direct"
  },
  {
    "author": "Sirio60",
    "cefr_estimate": "A2",
    "es": "Me gustó tu idea y la adopté.",
    "es_author": "tatoerique",
    "es_source_id": "359750",
    "id": "s_2143646",
    "it": "Mi è piaciuta la tua idea e l'ho adottata.",
    "license": "CC BY 2.0 FR",
    "source_id": "2143646",
    "translation_kind": "direct"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "A2",
    "es": "No vayas a mi cuarto.",
    "es_author": "cueyayotl",
    "es_source_id": "3886294",
    "id": "s_2527205",
    "it": "Non andare nella mia stanza.",
    "license": "CC BY 2.0 FR",
    "source_id": "2527205",
    "translation_kind": "direct"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "A2",
    "es": "Quizás lloverá por la tarde.",
    "es_author": "IA (Claude)",
    "id": "s_3050344",
    "it": "Forse pioverà nel pomeriggio.",
    "license": "CC BY 2.0 FR",
    "source_id": "3050344",
    "translation_kind": "llm"
  },
  {
    "author": "Pharamp",
    "cefr_estimate": "A2",
    "es": "Mi familia va a Italia todos los años.",
    "es_author": "quarzoliquido",
    "es_source_id": "480316",
    "id": "s_387491",
    "it": "La mia famiglia va in Italia tutti gli anni.",
    "license": "CC BY 2.0 FR",
    "source_id": "387491",
    "translation_kind": "direct"
  },
  {
    "author": "carlosalberto",
    "cefr_estimate": "B1",
    "es": "Se terminaron para mí todas las farras, mi cuerpo enfermo no resiste más.",
    "es_author": "carlosalberto",
    "es_source_id": "13694612",
    "id": "s_13694648",
    "it": "Per me è finita con le feste, il mio corpo malato non ce la fa più.",
    "license": "CC BY 2.0 FR",
    "source_id": "13694648",
    "translation_kind": "direct"
  },
  {
    "author": "JLGQ_",
    "cefr_estimate": "B1",
    "es": "Trabajó sin descanso para mantener a sus hijos hasta que se casaron.",
    "es_author": "JLGQ_",
    "es_source_id": "2229889",
    "id": "s_2229973",
    "it": "Ha lavorato senza pausa per mantenere i suoi figli fino a che si sono sposati.",
    "license": "CC BY 2.0 FR",
    "source_id": "2229973",
    "translation_kind": "direct"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "B1",
    "es": "Aunque Tom está enfermo, tiene la intención de terminar a tiempo sus tareas.",
    "es_author": "IA (Claude)",
    "id": "s_2970987",
    "it": "Nonostante Tom sia malato, ha intenzione di finire in tempo i suoi compiti.",
    "license": "CC BY 2.0 FR",
    "source_id": "2970987",
    "translation_kind": "llm"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "B1",
    "es": "Aunque Tom está enfermo, tiene la intención de terminar a tiempo sus tareas.",
    "es_author": "IA (Claude)",
    "id": "s_2970988",
    "it": "Nonostante Tom sia ammalato, ha intenzione di finire in tempo i suoi compiti.",
    "license": "CC BY 2.0 FR",
    "source_id": "2970988",
    "translation_kind": "llm"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "B1",
    "es": "El hombre que le dio su cheque de pago a su esposa fue más sabio que el que se lo dio a su amante.",
    "es_author": "carlosalberto",
    "es_source_id": "8844975",
    "id": "s_3021027",
    "it": "L'uomo che ha dato la sua busta paga alla moglie è stato più saggio di quello che l'ha data all'amante.",
    "license": "CC BY 2.0 FR",
    "source_id": "3021027",
    "translation_kind": "direct"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "B1",
    "es": "Glorieta o cenador es un espacio, generalmente redondo, que suele haber en los jardines, cercado por plantas o árboles y con bancos.",
    "es_author": "emigonza",
    "es_source_id": "3329293",
    "id": "s_3329302",
    "it": "Il gazebo, o pergolato, è uno spazio, di solito rotondo, che solitamente si trova nei giardini, circondato da piante o alberi e panchine.",
    "license": "CC BY 2.0 FR",
    "source_id": "3329302",
    "translation_kind": "direct"
  },
  {
    "author": "Guybrush88",
    "cefr_estimate": "B1",
    "es": "Hablando en general, Tom tiene razón.",
    "es_author": "saverius",
    "es_source_id": "10802981",
    "id": "s_4973103",
    "it": "Parlando in generale, Tom ha ragione.",
    "license": "CC BY 2.0 FR",
    "source_id": "4973103",
    "translation_kind": "direct"
  },
  {
    "author": "riccioberto",
    "cefr_estimate": "B1",
    "es": "Tengo que apuntar la dirección de él antes de que se me olvide.",
    "es_author": "tatoerique",
    "es_source_id": "346576",
    "id": "s_941983",
    "it": "Devo segnarmi il suo indirizzo prima che me lo scordi.",
    "license": "CC BY 2.0 FR",
    "source_id": "941983",
    "translation_kind": "direct"
  },
  {
    "author": "carlosalberto",
    "cefr_estimate": "B2",
    "es": "¿Hasta cuándo seguiremos creyendo que nacimos para el exterminio mutuo y que el exterminio mutuo es nuestro destino?",
    "es_author": "carlosalberto",
    "es_source_id": "13894882",
    "id": "s_13894907",
    "it": "Fino a quando continueremo a credere che siamo nati per sterminarci a vicenda e che lo sterminio reciproco sia il nostro destino?",
    "license": "CC BY 2.0 FR",
    "source_id": "13894907",
    "translation_kind": "direct"
  },
  {
    "author": "Heracleum",
    "cefr_estimate": "B2",
    "es": "Vino aunque le había dicho que no lo hiciera.",
    "es_author": "IA (Claude)",
    "id": "s_705357",
    "it": "È venuto nonostante gli avessi detto di non farlo.",
    "license": "CC BY 2.0 FR",
    "source_id": "705357",
    "translation_kind": "llm"
  }
]
